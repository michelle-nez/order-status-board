@page "/orders"
@using Microsoft.EntityFrameworkCore
@using OrderStatus.Data
@using OrderStatus.Data.Models
@inject IDbContextFactory<BoardDbContext> DbFactory

<PageTitle>Order board - Order Status Board</PageTitle>

<div class="d-flex flex-wrap align-center justify-space-between mb-5 gap-3">
    <div>
        <MudText Typo="Typo.h5">Order board</MudText>
        @if (orders is not null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @orders.Count open @(orders.Count == 1 ? "order" : "orders") ·
                @orders.Sum(o => o.Total).ToString("C") in the pipeline
            </MudText>
        }
    </div>
</div>

@if (orders is null || states is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else if (orders.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-10 d-flex flex-column align-center"
              Style="border:1px dashed var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" Class="mt-3">No open orders</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Add an order and it will appear in the first column.
        </MudText>
        <MudButton Href="/orders/new" Variant="Variant.Filled" Color="Color.Primary">New order</MudButton>
    </MudPaper>
}
else
{
    <div class="board-scroll">
        @foreach (var state in states)
        {
            var inState = orders.Where(o => o.OrderStateId == state.Id).ToList();
            <section class="board-column">
                <div class="column-head" style="border-top:3px solid @state.Accent;">
                    <MudText Typo="Typo.subtitle2">@state.Name</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">
                        @inState.Count
                    </MudChip>
                </div>

                @if (inState.Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="pa-2">Nothing here</MudText>
                }
                else
                {
                    @foreach (var order in inState)
                    {
                        <MudPaper Elevation="0" Class="pa-3 mb-2"
                                  Style="border:1px solid var(--mud-palette-divider);">
                            <MudLink Href="@($"/orders/edit/{order.Id}")" Typo="Typo.body2"
                                     Style="font-family:Consolas,monospace;font-weight:600;">
                                @order.OrderNumber
                            </MudLink>
                            <MudText Typo="Typo.body2" Class="mt-1">@order.Customer?.Name</MudText>
                            <div class="d-flex align-center justify-space-between mt-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@order.Channel</MudChip>
                                <MudText Typo="Typo.body2" Style="font-weight:700;">@order.Total.ToString("C")</MudText>
                            </div>
                            <div class="d-flex justify-end mt-1">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Size="Size.Small"
                                               Disabled="@(!CanMove(state, -1))" aria-label="Move back"
                                               OnClick="@(() => MoveAsync(order.Id, -1))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small"
                                               Disabled="@(!CanMove(state, 1))" aria-label="Move forward"
                                               OnClick="@(() => MoveAsync(order.Id, 1))" />
                            </div>
                        </MudPaper>
                    }
                }
            </section>
        }
    </div>
}

@code {
    private List<Order>? orders;
    private List<OrderState>? states;

    protected override async Task OnInitializedAsync()
    {
        await LoadBoardAsync();
    }

    // Its own method so the move action can refresh by calling it.
    private async Task LoadBoardAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        states = await db.OrderStates
            .AsNoTracking()
            .OrderBy(s => s.SortOrder)
            .ToListAsync();

        orders = await db.Orders
            .AsNoTracking()
            .Include(o => o.Customer)
            .Include(o => o.OrderState)
            .Where(o => !o.IsCancelled)
            .OrderBy(o => o.PlacedUtc)
            .ToListAsync();
    }

    // There is nowhere to move from the first column back, or the last forward.
    private bool CanMove(OrderState state, int direction) =>
        states is not null && states.Any(s => s.SortOrder == state.SortOrder + direction);

    private async Task MoveAsync(int orderId, int direction)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var order = await db.Orders
            .Include(o => o.OrderState)
            .FirstOrDefaultAsync(o => o.Id == orderId);

        if (order?.OrderState is null)
        {
            return;
        }

        // Look up the neighbouring column by SortOrder rather than by id - ids are
        // not guaranteed to run in board order.
        var target = await db.OrderStates
            .FirstOrDefaultAsync(s => s.SortOrder == order.OrderState.SortOrder + direction);

        if (target is not null)
        {
            order.OrderStateId = target.Id;
            await db.SaveChangesAsync();
        }

        await LoadBoardAsync();
    }
}
