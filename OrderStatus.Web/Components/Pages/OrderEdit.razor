@page "/orders/new"
@page "/orders/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OrderStatus.Data
@using OrderStatus.Data.Models
@inject IDbContextFactory<BoardDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "New order" : "Edit order") - Order Status Board</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">@(Id is null ? "New order" : "Edit order")</MudText>

@if (order is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudPaper Elevation="0" Class="pa-6" Style="max-width:540px;border:1px solid var(--mud-palette-divider);">
        <EditForm Model="order" OnValidSubmit="SaveAsync" FormName="order-form">
            <DataAnnotationsValidator />

            @if (errorMessage is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="order.OrderNumber" Label="Order number" For="() => order.OrderNumber"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />

            <MudSelect @bind-Value="order.CustomerId" Label="Customer" For="() => order.CustomerId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="int" Value="0">-- choose a customer --</MudSelectItem>
                @foreach (var customer in customers)
                {
                    <MudSelectItem T="int" Value="@customer.Id">@customer.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect @bind-Value="order.OrderStateId" Label="Status" For="() => order.OrderStateId"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                <MudSelectItem T="int" Value="0">-- choose a status --</MudSelectItem>
                @foreach (var state in states)
                {
                    <MudSelectItem T="int" Value="@state.Id">@state.Name</MudSelectItem>
                }
            </MudSelect>

            <MudSelect @bind-Value="order.Channel" Label="Channel" For="() => order.Channel"
                       Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                @foreach (var channel in Channels)
                {
                    <MudSelectItem T="string" Value="@channel">@channel</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField @bind-Value="order.Total" Label="Total" For="() => order.Total"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Step="0.01M"
                             Format="F2" Class="mb-4" />

            <div class="d-flex flex-wrap align-center gap-2">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </MudButton>
                <MudButton Href="/orders" Variant="Variant.Text">Cancel</MudButton>

                @if (Id is not null && !order.IsCancelled)
                {
                    <MudSpacer />
                    @if (confirmCancel)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error">Cancel this order?</MudText>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                                   OnClick="CancelOrderAsync">Yes</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="@(() => confirmCancel = false)">Keep it</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                   OnClick="@(() => confirmCancel = true)">Cancel order</MudButton>
                    }
                }
            </div>
        </EditForm>
    </MudPaper>
}

@code {
    private static readonly string[] Channels = ["Shopify", "Amazon", "Walmart", "eBay", "Phone"];

    [Parameter]
    public int? Id { get; set; }

    private Order? order;
    private List<Customer> customers = new();
    private List<OrderState> states = new();
    private string? errorMessage;
    private bool isSaving;
    private bool confirmCancel;

    protected override async Task OnParametersSetAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        customers = await db.Customers.AsNoTracking().OrderBy(c => c.Name).ToListAsync();
        states = await db.OrderStates.AsNoTracking().OrderBy(s => s.SortOrder).ToListAsync();

        if (Id is null)
        {
            // A new order starts in the first board column.
            order = new Order { OrderStateId = states.FirstOrDefault()?.Id ?? 0 };
            return;
        }

        order = await db.Orders.AsNoTracking().FirstOrDefaultAsync(o => o.Id == Id);

        if (order is null)
        {
            // The id matched nothing. Send them back rather than showing a broken form.
            Nav.NavigateTo("/orders");
        }
    }

    private async Task SaveAsync()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (order!.Id == 0)
            {
                db.Orders.Add(order);
            }
            else
            {
                db.Orders.Update(order);
            }

            await db.SaveChangesAsync();
            Nav.NavigateTo("/orders");
        }
        catch (DbUpdateException)
        {
            // The unique index rejected it. Almost always a duplicate order number.
            errorMessage = $"Order number '{order!.OrderNumber}' is already in use. Pick a different one.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.Orders.FirstOrDefaultAsync(o => o.Id == Id);

        if (existing is not null)
        {
            // Hide it, do not destroy it. The board query already filters cancelled orders.
            existing.IsCancelled = true;
            await db.SaveChangesAsync();
        }

        Nav.NavigateTo("/orders");
    }
}
